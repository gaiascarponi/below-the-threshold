# ------------------------------------------------------------------
# below-the-threshold: what is NOT versioned
# Rule: everything is versioned (code and results) except the input
# data downloaded from public sources and files above GitHub's
# 100 MB limit. Empty input folders are kept (.gitkeep) to show the
# expected structure.
# ------------------------------------------------------------------

# OS and RStudio files
.DS_Store
.Rhistory
*.history
.RData
.Ruserdata
.Rproj.user/

# Input data downloaded from GEO (GSE97356, GSE64813, GSE221766, GSE70603)
*/01_source/**
!*/01_source/**/

# Normalized expression matrices used as SWIMmeR input (derived from GEO,
# regenerated by the scripts; one file exceeds 100 MB)
SWIMmeR/project/*/dataset/**
!SWIMmeR/project/*/dataset/**/
# ...except the sample group lists, needed to rerun SWIMmeR with the same groups
!SWIMmeR/project/**/list/condition_bin_*.txt

# Raw GBD 2023 downloads (IHME terms of use: download from the GBD Results Tool)
DALY/data/source/**
!DALY/data/source/**/

# SWIMmeR source code (third-party tool, not redistributed; see README)
SWIMmeR/src/

# Literature (copyrighted PDFs)
Papers/
DALY/papers/
DALY/old/

# Internal working notes
PIPELINE.md
HANDOFF*.md

# Keep the folder structure
!**/.gitkeep
